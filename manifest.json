{
  "manifest_version": 3,
  "name": "Copy to Figma",
  "version": "1.0.0",
  "description": "Copy the website and paste into Figma",
  "permissions": [
    "activeTab",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Copy to Figma"
  },
  "commands": {
    "copy-to-figma": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "MacCtrl+Command+P"
      },
      "description": "Copy the current page to Figma"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}